# Flux for the lab: installed by scripts/lab.sh after the apply. Plain KEY=value lines, sourced by lab.sh.
# The same release as shadewright-fleet scripts/tools.env (which Kind uses): bump both together. The install.yaml
# is verified against the checksum the release publishes, and the manifest names its images by tag only, so each
# controller image is pinned to its multi-arch index digest here before anything is applied. Only the four
# controllers the lab uses are installed (source, kustomize, helm, notification).
FLUX_VERSION=v2.10.0
FLUX_INSTALL_SHA256=a8c838ccd9be5d30eba9df87cd229b7c4eb80c0049fba1bc3b9840829f267f28
FLUX_IMAGES="helm-controller=v1.7.1@sha256:54526cc6ed1202d71d44c310676448065664f3255ad671d9a69ac26f904e617a kustomize-controller=v1.10.1@sha256:37db29b25dae35b881a5e064acedb0cc954442da453a39eaa0eab7a90dbecc4e notification-controller=v1.10.0@sha256:9f58b9532ec9d3ccf539cd3ccdf283477a5dcb7777b922db5477d8bbd4d3767c source-controller=v1.10.1@sha256:611b6bca3eae95bcff471414d1fb14a4ab83d7f14e609cccef2bd389c121f37e"
