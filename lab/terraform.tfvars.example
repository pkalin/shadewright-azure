subscription_id = "00000000-0000-0000-0000-000000000000"
prefix          = "shadewright"
admin_ip_cidrs  = ["203.0.113.10/32"]

state_backend = {
  resource_group_name  = "rg-shadewright-tfstate"
  storage_account_name = "stshadewrighttfxxxxxx"
  container_name       = "tfstate"
}

# Flux and the fleet workloads are off by default (a bare cluster). To turn them on, name the repository you
# chose: Flux applies whatever lands on its branch.
# flux_enabled         = true
# fleet_repository_url = "https://github.com/<you>/shadewright-fleet"
